"""
Build, lint, test, and sign Android Gradle projects with a containerized SDK.
"""
type Android {
  """
  Project context, including any sibling projects needed by Gradle.
  """
  source: Directory

  """
  Prepared source container. Takes precedence over source when provided.
  """
  sourceCtr: Container

  """
  Directory inside sourceCtr to use as the project context.
  """
  sourcePath: String!

  """
  Gradle project root relative to the context (the directory with gradlew).
  """
  projectPath: String!

  """
  Android API level used to choose the default SDK image.
  """
  compileSdk: Int!

  """
  SDK/JDK image override; empty selects ghcr.io/cirruslabs/android-sdk:<compileSdk>.
  """
  baseImageAddress: String!

  """
  Optional SDK/JDK container, including custom environment, secrets, or services.
  """
  baseCtr: Container

  """
  Build platform. The default supports Google's Linux x86_64 Android tools.
  """
  platform: Platform!

  """
  Gradle project selector, e.g. app or :apps:mobile. Empty selects the root project.
  """
  gradleModule: String!

  """
  Module directory relative to projectPath, independent of its Gradle selector.
  """
  modulePath: String!

  """
  Build directory relative to the Gradle root; empty uses <modulePath>/build.
  """
  buildDirectory: String!

  """
  Paths excluded from the context. Override to retain prebuilt dependencies when needed.
  """
  sourceExcludes: [String!]!

  """
  Variant used by build, lint, and test checks, including flavors (e.g. demoDebug).
  """
  checkVariant: String!

  """
  Gradle executable and initial arguments. Defaults to the project's wrapper via sh.
  """
  gradleCommand: [String!]!

  """
  Additional arguments for every Gradle invocation. Use secrets on baseCtr for credentials.
  """
  gradleArguments: [String!]!

  """
  Cache namespace. Change it to isolate dependency caches between projects.
  """
  cacheKey: String!

  """
  Exact archive entries required in every APK produced by the build check.
  """
  requiredApkPaths: [String!]!

  new(
    source: Directory,
    sourceCtr: Container,
    sourcePath: String! = ".",
    projectPath: String! = ".",
    compileSdk: Int! = 36,
    baseImageAddress: String! = "",
    baseCtr: Container,
    platform: Platform! = "linux/amd64",
    gradleModule: String! = "app",
    modulePath: String! = "app",
    buildDirectory: String! = "",
    sourceExcludes: [String!]! = ["**/.gradle", "**/build", "**/local.properties"],
    checkVariant: String! = "debug",
    gradleCommand: [String!]! = ["sh", "./gradlew"],
    gradleArguments: [String!]! = [],
    cacheKey: String! = "android-gradle",
    requiredApkPaths: [String!]! = [],
  ) {
    if (source == null and sourceCtr == null) {
      raise "provide source or sourceCtr containing a Gradle project"
    }
    if (gradleCommand == []) { raise "gradleCommand must not be empty" }
    if (checkVariant == "") { raise "checkVariant must not be empty" }
    if (compileSdk <= 0) { raise "compileSdk must be positive" }
    self.source = source
    self.sourceCtr = sourceCtr
    self.sourcePath = sourcePath
    self.projectPath = projectPath
    self.compileSdk = compileSdk
    self.baseImageAddress = baseImageAddress
    self.baseCtr = baseCtr
    self.platform = platform
    self.gradleModule = gradleModule
    self.modulePath = modulePath
    self.buildDirectory = buildDirectory
    self.sourceExcludes = sourceExcludes
    self.checkVariant = checkVariant
    self.gradleCommand = gradleCommand
    self.gradleArguments = gradleArguments
    self.cacheKey = cacheKey
    self.requiredApkPaths = requiredApkPaths
    self
  }

  let context: Directory! {
    if (sourceCtr != null) {
      sourceCtr.directory(sourcePath)
    } else if (source != null) { source } else { raise "provide source or sourceCtr" }
  }

  # Keep relative paths inside the mounted context; spaces are valid.
  let relativePath(path: String!): String! {
    if (path.hasPrefix("/") or path.split("/").contains("..")) {
      raise `expected a relative path without '..': ${path}`
    }
    if (path == "" or path == ".") { "." } else { path.trimSuffix("/") }
  }

  let workdir: String! { "/project/" + relativePath(projectPath) }

  let task(prefix: String!, variant: String!, suffix: String! = ""): String! {
    if (variant == "") { raise "variant must not be empty" }
    let first = variant.split("")[0] ?? ""
    let name = prefix + first.toUpper + variant.trimPrefix(first) + suffix
    let selector = gradleModule.trim(":")
    if (selector == "") { ":" + name } else { ":" + selector + ":" + name }
  }

  let command(tasks: [String!]!, arguments: [String!]! = []): [String!]! {
    if (tasks == []) { raise "provide at least one Gradle task" }
    gradleCommand + ["--no-daemon"] + gradleArguments + tasks + arguments
  }

  let outputDirectory(kind: String!, outputPath: String!): String! {
    if (outputPath != "") {
      workdir + "/" + relativePath(outputPath)
    } else {
      workdir + "/" + buildPath + "/outputs/" + kind
    }
  }

  let buildPath: String! {
    if (buildDirectory != "") {
      relativePath(buildDirectory)
    } else {
      relativePath(modulePath) + "/build"
    }
  }

  """
  SDK container with source and locked Gradle dependency caches. Host build
  outputs, Gradle state, and local SDK paths are excluded from the context.
  When baseCtr is supplied, its platform and toolchain take precedence.
  """
  base: Container! {
    let ctr = if (baseCtr != null) {
      baseCtr
    } else {
      let image = if (baseImageAddress != "") {
        baseImageAddress
      } else {
        `ghcr.io/cirruslabs/android-sdk:${compileSdk}`
      }
      container(platform: platform).from(image)
    }
    ctr
      .withMountedCache("/gradle/caches", cacheVolume(cacheKey + "-caches"), sharing: CacheSharingMode.LOCKED)
      .withMountedCache("/gradle/wrapper", cacheVolume(cacheKey + "-wrapper"), sharing: CacheSharingMode.LOCKED)
      .withEnvVariable("GRADLE_USER_HOME", "/gradle")
      # Always discard this module's prior outputs, including custom build dirs.
      .withDirectory(
        "/project",
        context.withoutDirectory(relativePath(projectPath) + "/" + buildPath),
        exclude: sourceExcludes,
      )
      .withWorkdir(workdir)
  }

  """
  Run arbitrary Gradle tasks and return the resulting container for further
  customization or artifact/report extraction. Task names are passed verbatim.
  """
  run(tasks: [String!]!, arguments: [String!]! = []): Container! {
    base.withExec(command(tasks, arguments))
  }

  """
  Assemble a variant and return its APK output tree (including split APKs and
  metadata). For a library, set outputPath to its AAR output directory.
  outputPath is relative to the Gradle project root.
  """
  assemble(variant: String! = "debug", outputPath: String! = ""): Directory! {
    run([task("assemble", variant)]).directory(outputDirectory("apk", outputPath))
  }

  """
  Build an Android App Bundle variant and return its output tree. Signing, if
  any, follows the project's Gradle configuration. outputPath is relative to
  the Gradle project root and supports custom build directories.
  """
  bundle(variant: String! = "release", outputPath: String! = ""): Directory! {
    run([task("bundle", variant)]).directory(outputDirectory("bundle", outputPath))
  }

  """
  Assemble checkVariant and, if configured, verify exact entries in every APK.
  """
  build: Void @check {
    let built = run([task("assemble", checkVariant)])
    if (requiredApkPaths == []) {
      built.sync
    } else {
      let outputs = outputDirectory("apk", "")
      let apks = built.directory(outputs).glob("**/*.apk")
      if (apks == []) { raise "build produced no APKs to verify" }
      apks.map { apk =>
        built.withExec([
          "sh", "-eu", "-c",
          """
          apk=$1
          shift
          entries=$(mktemp)
          trap 'rm -f "$entries"' EXIT
          jar tf "$apk" > "$entries"
          for entry do
            if ! grep -F -x -- "$entry" "$entries" > /dev/null; then
              printf 'Missing from APK %s: %s\n' "$apk" "$entry" >&2
              exit 1
            fi
          done
          """,

          "verify-apk", outputs + "/" + apk,
        ] + requiredApkPaths).sync
      }
    }
    null
  }

  """
  Run Android Lint for checkVariant. Reports remain available through run.
  """
  lint: Void @check {
    run([task("lint", checkVariant)]).sync
    null
  }

  """
  Run all JVM unit tests directly, without collection discovery. The test
  checks are exposed per class through tests, so selecting classes does not
  also run the entire suite.
  """
  test: Void {
    run([task("test", checkVariant, "UnitTest")]).sync
    null
  }

  """
  JVM test classes for checkVariant, discovered from Java and Kotlin sources in
  the module's unit-test source sets (src/test and src/test<Variant part>).
  Listing runs no Gradle, JDK, or SDK container: one pinned, source-only scan
  reads the test sources. Device tests are excluded.
  """
  tests: TestClasses! {
    TestClasses(names: testClassNames, tool: self)
  }

  # The module directory, relative to the context, with a trailing slash.
  let modulePrefix: String! {
    [relativePath(projectPath), relativePath(modulePath)]
      .filter { part => part != "." }
      .map { part => part + "/" }
      .join("")
  }

  let testClassNames: [String!]! {
    let src = modulePrefix + "src"
    testHelperContainer
      .withDirectory("/scan", context, include: [src + "/test*/**/*.java", src + "/test*/**/*.kt"])
      .withExec(["android-tests", "discover", "--root", "/scan/" + src], redirectStdout: "/classes.tsv")
      .file("/classes.tsv")
      .contents
      .split("\n")
      .filter { line => line != "" and variantSourceSet(line.split("\t")[1] ?? "") }
      .map { line => line.split("\t")[0]! }
      .uniq
  }

  # Unit-test source sets apply to a variant when their suffix is a run of
  # whole words of it: testDemo, testDebug and testDemoDebug for demoDebug.
  let variantSourceSet(name: String!): Boolean! {
    let suffix = name.trimPrefix("test")
    if (suffix == "") {
      name == "test"
    } else {
      let first = suffix.split("")[0] ?? ""
      let variantFirst = checkVariant.split("")[0] ?? ""
      let words = variantFirst.toUpper + checkVariant.trimPrefix(variantFirst) + "!"
      first != first.toLower and (["!"] + "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("")).any { next =>
        words.contains(suffix + next)
      }
    }
  }

  # Exact, pinned image for the module's own helper, independent of the
  # project's toolchain.
  let testHelperImage: String! { "golang:1.25.4-alpine3.22" }

  # Discovers test classes from source and indexes shared run events. Built
  # once: its inputs are the pinned image and this module's helper source.
  let testHelperContainer: Container! {
    container
      .from(testHelperImage)
      .withDirectory("/src/android-tests", currentModule.source.directory("helpers/android-tests"))
      .withWorkdir("/src/android-tests")
      .withEnvVariable("CGO_ENABLED", "0")
      .withExec(["go", "build", "-trimpath", "-o", "/usr/local/bin/android-tests", "."])
      .withWorkdir("/")
  }

  # The container and command every selected class check shares, before any
  # --tests filters. Only a run builds them; listing never does.
  let testRunner: Container! {
    base
      .withFile("/opt/dagger-android/report-tests.gradle", currentModule.source.file("scripts/report-tests.gradle"))
      .withEnvVariable("DAGGER_ANDROID_TEST_TASK", task("test", checkVariant, "UnitTest"))
      .withEnvVariable("DAGGER_ANDROID_TEST_REPORT", "/tmp/dagger-android-test-events.jsonl")
  }

  let testCommand: [String!]! {
    command([task("test", checkVariant, "UnitTest")], [
      "--init-script", "/opt/dagger-android/report-tests.gradle", "--no-configuration-cache",
    ])
  }

  """
  Build and verify signed AABs. Gradle must read ANDROID_KEYSTORE_FILE,
  ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, and ANDROID_KEY_PASSWORD.
  Keystore bytes and passwords use Dagger secrets. Tasks always rerun with the
  Gradle build cache disabled so previous signed outputs cannot be reused.
  This function builds artifacts only; it does not upload or publish them.
  """
  signedBundle(
    keystore: Secret!,
    keystorePassword: Secret!,
    keyAlias: String!,
    keyPassword: Secret!,
    variant: String! = "release",
    outputPath: String! = "",
  ): Directory! {
    let outputs = outputDirectory("bundle", outputPath)
    let built = base
      .withMountedSecret("/run/signing/keystore", keystore)
      .withEnvVariable("ANDROID_KEYSTORE_FILE", "/run/signing/keystore")
      .withEnvVariable("ANDROID_KEY_ALIAS", keyAlias)
      .withSecretVariable("ANDROID_KEYSTORE_PASSWORD", keystorePassword)
      .withSecretVariable("ANDROID_KEY_PASSWORD", keyPassword)
      .withExec(command([task("bundle", variant)], ["--rerun-tasks", "--no-build-cache"]))
    let bundles = built.directory(outputs).glob("**/*.aab")
    if (bundles == []) { raise "build produced no AABs to verify" }
    bundles.map { aab =>
      built.withExec([
        "sh", "-eu", "-c",
        """
        report=$(mktemp)
        trap 'rm -f "$report"' EXIT
        if ! jarsigner -J-Duser.language=en -J-Duser.country=US -verify -strict \
          -keystore "$ANDROID_KEYSTORE_FILE" -storepass:env ANDROID_KEYSTORE_PASSWORD \
          "$1" "$ANDROID_KEY_ALIAS" > "$report" 2>&1; then
          cat "$report" >&2
          printf 'AAB signature verification failed: %s\n' "$1" >&2
          exit 1
        fi
        if ! grep -F 'jar verified.' "$report" > /dev/null; then
          cat "$report" >&2
          printf 'AAB signature verification failed: %s\n' "$1" >&2
          exit 1
        fi
        """,

        "verify-aab", outputs + "/" + aab,
      ]).sync
    }
    built.directory(outputs)
  }
}

"""
JVM test classes discovered by Gradle for the configured Android variant.
"""
type TestClasses @collection {
  """
  Fully qualified test class names, sorted and deduplicated.
  """
  names: [String!]! @keys

  """
  Changes to the discovered selection.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed test classes from this collection.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  let tool: Android!

  """
  Select one test class.
  """
  testClass(name: String!): TestClass! @get {
    TestClass(name: name)
  }

  """
  Run these test classes in one Gradle invocation and fail if any failed. This
  is a plain function, not a check: dagger check runs each class's own check,
  and those share a single Gradle invocation.
  """
  test: Void {
    if (names != []) {
      let shared = results
      let failures = names.map { name =>
        { shared.assertPassed(name); "" } rescue { err: Error => err.message }
      }.filter { failure => failure != "" }
      if (failures != []) { raise failures.join("\n") }
    }
    null
  }

  """
  One Gradle command and report shared by every selected test class.

  It depends only on this collection, never on the class asking, so every
  selected class check builds a byte-identical command and the engine runs it
  once. An unnarrowed selection runs the task with Gradle's own configuration;
  otherwise each selected class becomes a --tests filter, in byte order.
  """
  let results: TestResults! {
    if (names.length == 0) { raise "no test classes selected" }
    let empty: [String!]! = []
    let filters = if (narrowed) {
      sorted(names).reduce(empty) { args, name => args + ["--tests", name] }
    } else { empty }
    # Never let the shared command raise: that would fail every class with the
    # same message. The indexer attributes Gradle's exit status instead.
    let executed = tool.testRunner.withExec(
      tool.testCommand + filters,
      expect: ANY,
      redirectStderr: "/tmp/dagger-android-gradle-stderr.log",
    )
    let indexed = tool.testHelperContainer
      .withDirectory(
        "/report",
        executed.directory("/tmp"),
        include: ["dagger-android-test-events.jsonl", "dagger-android-gradle-stderr.log"],
      )
      .withNewFile("/report/selection.json", JSON.encode(names))
      .withExec([
        "android-tests", "index",
        "--report", "/report/dagger-android-test-events.jsonl",
        "--stderr", "/report/dagger-android-gradle-stderr.log",
        "--selection", "/report/selection.json",
        "--exit-code", `${executed.exitCode}`,
        "--output", "/results",
      ])
    TestResults(results: indexed.directory("/results"), names: names)
  }

  # Byte order, matching the indexer's sort.Strings.
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }
}

"""
A JVM test class, including its parameterized cases and inherited tests.
"""
type TestClass {
  """
  Fully qualified test class name.
  """
  name: String!

  """
  Run this class's tests. The engine passes the selected test classes, so
  every selected class shares one Gradle invocation and reads only its own
  result from it.
  """
  test(selection: TestClasses!): Void @check {
    selection.results.assertPassed(name)
  }
}

# The indexer's bounded results, one file per selected class.
type TestResults {
  let results: Directory!
  let names: [String!]!

  let assertPassed(name: String!): Void {
    if (names.contains(name) == false) { raise "test class is outside the selection: " + name }
    # Numeric byte-order ranks keep class names out of file paths.
    let rank = names.filter { other => other < name }.length
    let failure = results.file(`${rank}`).contents
    if (failure != "") { raise failure }
    null
  }
}
